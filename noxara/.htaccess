# ============================================================
# NOXARA - Apache .htaccess
# Requires: mod_rewrite, mod_headers, mod_deflate, mod_expires
# ============================================================

Options -Indexes -MultiViews
ServerSignature Off

# ============================================================
# REWRITE ENGINE
# ============================================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect www to non-www (optional — uncomment if needed)
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # Force HTTPS (uncomment after SSL is set up)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Block access to install after installed
    # RewriteCond %{REQUEST_URI} ^/install/ [NC]
    # RewriteRule ^ - [F,L]

    # Skip rewrite for existing files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Clean URLs — route everything through index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# ============================================================
# BLOCK SENSITIVE DIRECTORIES & FILES
# ============================================================
<FilesMatch "\.(sql|env|log|bak|sh|htpasswd)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    # Block config directory
    RewriteRule ^config/.*$ - [F,L]
    # Block logs directory
    RewriteRule ^logs/.*$ - [F,L]
    # Block backups directory
    RewriteRule ^backups/.*$ - [F,L]
    # Block database directory
    RewriteRule ^database/.*$ - [F,L]
    # Block .git directory
    RewriteRule ^\.git/.*$ - [F,L]
    # Block dot files
    RewriteRule (^|/)\. - [F,L]
</IfModule>

# ============================================================
# SECURITY HEADERS
# ============================================================
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # HSTS (uncomment after SSL is configured):
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# ============================================================
# PHP SETTINGS (override php.ini)
# ============================================================
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size       10M
    php_value max_execution_time  120
    php_value memory_limit        256M
    php_flag  display_errors      Off
    php_flag  log_errors          On
    php_value date.timezone       Asia/Jakarta
</IfModule>

# ============================================================
# GZIP / DEFLATE COMPRESSION
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml

    # Don't compress images (already compressed)
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|ico)$ no-gzip dont-vary
</IfModule>

# ============================================================
# BROWSER CACHING (Expires)
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On

    # CSS & JS — 1 year (versioned by query string)
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType text/javascript           "access plus 1 year"

    # Images — 1 month
    ExpiresByType image/jpeg                "access plus 1 month"
    ExpiresByType image/png                 "access plus 1 month"
    ExpiresByType image/webp                "access plus 1 month"
    ExpiresByType image/gif                 "access plus 1 month"
    ExpiresByType image/svg+xml             "access plus 1 month"
    ExpiresByType image/x-icon              "access plus 1 year"

    # Fonts — 1 year
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType font/woff                 "access plus 1 year"
    ExpiresByType application/font-woff     "access plus 1 year"

    # No cache for PHP / HTML
    ExpiresByType text/html                 "access plus 0 seconds"
    ExpiresByType application/json          "access plus 0 seconds"
</IfModule>

# Manifest & service worker — no cache
<FilesMatch "(manifest\.json|service-worker\.js)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-store, no-cache, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</FilesMatch>

# ============================================================
# CUSTOM ERROR PAGES
# ============================================================
ErrorDocument 404 /errors/404.php
ErrorDocument 500 /errors/500.php
ErrorDocument 403 /errors/404.php
